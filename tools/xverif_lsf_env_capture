#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"
export XVERIF_LSF_CLI_ENTRY_DIR="$script_dir"

python_bin="${PYTHON:-python3}"
command -v "$python_bin" >/dev/null 2>&1 || {
  echo "ERROR: Python interpreter not found: $python_bin; set PYTHON" >&2
  exit 2
}

exec "$python_bin" "$root/xverif_mcp/src/xverif_loop/env_config.py" "$@"
