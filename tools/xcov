#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"
export XVERIF_HOME="${XVERIF_HOME:-$root}"

# Default: the Python/URG implementation. The C++/UCAPI backend is an opt-in
# trial because it requires a separately installed Verdi UCAPI runtime; this
# repository does not distribute UCAPI headers or libraries.
backend="${XVERIF_XCOV_BACKEND:-urg}"

case "$backend" in
  ucapi)
    binary="$root/xcov/bin/xcov"
    if [ ! -x "$binary" ]; then
      echo "ERROR: C++ xcov binary not found: $binary; run 'make -C xcov'" >&2
      exit 2
    fi
    exec "$binary" "$@"
    ;;
  urg)
    python_bin="${PYTHON:-${XVERIF_XCOV_PYTHON:-${XVERIF_HOME}/.conda-xverif/bin/python}}"
    command -v "$python_bin" >/dev/null 2>&1 || {
      echo "ERROR: Python interpreter not found: $python_bin; set PYTHON or XVERIF_XCOV_PYTHON" >&2
      exit 2
    }
    export PYTHONPATH="$root/xcov${PYTHONPATH:+:${PYTHONPATH}}"
    exec "$python_bin" -m xcov.cli "$@"
    ;;
  *)
    echo "ERROR: XVERIF_XCOV_BACKEND must be 'ucapi' or 'urg', got: $backend" >&2
    exit 2
    ;;
esac
