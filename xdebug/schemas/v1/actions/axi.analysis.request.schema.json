{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.axi.analysis.request.v1",
  "title": "axi.analysis request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "axi.analysis"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "analysis": {
          "type": "string",
          "enum": [
            "latency",
            "osd",
            "pending"
          ],
          "description": "选择协议分析视图；每个视图返回不同的 primary data 对象。"
        },
        "direction": {
          "type": "string",
          "enum": [
            "write",
            "read",
            "all"
          ],
          "description": "协议 transaction 的方向过滤；read/write/all 的可用性以本 action enum 为准。"
        },
        "line_limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
        },
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        },
        "render_time_unit": {
          "type": "string",
          "enum": [
            "auto",
            "ps",
            "ns",
            "us"
          ],
          "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
        },
        "value_format": {
          "type": "string",
          "enum": [
            "hex",
            "bin",
            "dec"
          ],
          "default": "hex",
          "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "analysis"
              ],
              "properties": {
                "analysis": {
                  "const": "pending"
                }
              }
            },
            {
              "not": {
                "required": [
                  "line_limit"
                ]
              }
            }
          ]
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Analyze AXI latency, pending transactions, and outstanding activity.",
  "x-purpose": "汇总 AXI 行为。",
  "x-how_it_works": "analysis 取 latency、osd 或 pending，分别统计完成事务延迟、outstanding 变化和扫描结束未闭合事务。",
  "x-when_to_use": "快速判断 AXI 接口健康度。",
  "x-arg_contract_notes": "required: name",
  "x-description-zh": "汇总 AXI 行为。",
  "x-agent": {
    "use_when": [
      "Need a derived latency, pending, or outstanding analysis across reconstructed AXI transactions rather than raw rows."
    ],
    "do_not_use_when": [
      "Do not use it for a raw transaction listing, a single outlier ranking, or aggregate filtered counts."
    ],
    "alternatives": [
      {
        "action": "axi.query",
        "when": "Inspect selected AXI channels or reconstructed transactions."
      },
      {
        "action": "axi.latency_outlier",
        "when": "Rank or threshold abnormal-latency transactions."
      },
      {
        "action": "axi.statistics",
        "when": "Count completed AXI transactions after filters."
      }
    ],
    "constraints": [
      "required: name"
    ]
  }
}
