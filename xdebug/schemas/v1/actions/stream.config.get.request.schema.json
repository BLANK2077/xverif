{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.stream.config.get.request.v1",
  "title": "stream.config.get request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "stream.config.get"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        }
      },
      "additionalProperties": false
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Read one saved stream configuration without resolving waveform metadata.",
  "x-description-zh": "读取一个已保存的原始 stream 配置，不解析波形元数据。",
  "x-purpose": "读取一个原始 stream 配置。",
  "x-how_it_works": "按 name 返回保存时的原始配置，不做解析或活动语义投影。",
  "x-when_to_use": "精确读取已保存配置内容。",
  "x-arg_contract_notes": "required: name",
  "x-agent": {
    "use_when": [
      "Read the persisted definition for one exact stream configuration name."
    ],
    "do_not_use_when": [
      "Listing all stream names or resolving the configuration against the active waveform."
    ],
    "alternatives": [
      {
        "action": "stream.describe",
        "when": "Resolved signals and static validation against the active waveform are required."
      }
    ],
    "constraints": [
      "required: name"
    ]
  }
}
