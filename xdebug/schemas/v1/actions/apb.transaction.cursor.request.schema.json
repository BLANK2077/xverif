{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.apb.transaction.cursor.request.v1",
  "title": "apb.transaction.cursor request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "apb.transaction.cursor"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name",
        "op"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "write",
            "read",
            "all"
          ],
          "description": "协议 transaction 的方向过滤；read/write/all 的可用性以本 action enum 为准。"
        },
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        },
        "op": {
          "type": "string",
          "enum": [
            "begin",
            "next",
            "prev",
            "pre",
            "last"
          ],
          "description": "游标移动或协议浏览操作。"
        },
        "render_time_unit": {
          "type": "string",
          "enum": [
            "auto",
            "ps",
            "ns",
            "us"
          ],
          "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
        },
        "value_format": {
          "type": "string",
          "enum": [
            "hex",
            "bin",
            "dec"
          ],
          "default": "hex",
          "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Move a cursor across APB transfers.",
  "x-purpose": "在 APB transfer 间移动游标。",
  "x-how_it_works": "基于 APB 查询结果按 op/direction 定位 begin/next/prev 等。",
  "x-when_to_use": "交互式浏览 APB 事务。",
  "x-arg_contract_notes": "required: name, op",
  "x-description-zh": "在 APB transfer 间移动游标。",
  "x-agent": {
    "use_when": [
      "Need stateful begin/next/prev navigation through decoded APB transfers one item at a time."
    ],
    "do_not_use_when": [
      "Do not use it for arbitrary waveform time bookmarks or bulk APB filtering."
    ],
    "alternatives": [
      {
        "action": "waveform.cursor.set",
        "when": "Store an arbitrary waveform time bookmark."
      },
      {
        "action": "apb.query",
        "when": "Filter or enumerate APB transfers."
      }
    ],
    "constraints": [
      "required: name, op"
    ]
  }
}
