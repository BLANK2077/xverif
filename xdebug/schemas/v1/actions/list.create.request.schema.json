{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.list.create.request.v1",
  "title": "list.create request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "list.create"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Signal-path list or alias-to-path/expression map. Expressions must reference aliases rather than nested paths."
          },
          "description": "信号列表，或 alias 到信号路径的映射。"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Create a named waveform signal list.",
  "x-purpose": "创建命名信号列表。",
  "x-how_it_works": "在 ListManager 存储中创建 list，并可追加初始 signals。",
  "x-when_to_use": "为一组信号建立可复用集合。",
  "x-arg_contract_notes": "required: name",
  "x-description-zh": "创建命名信号列表。",
  "x-agent": {
    "use_when": [
      "Need a new or replaced named collection of waveform signal paths for repeated multi-signal operations."
    ],
    "do_not_use_when": [
      "Do not use it to append to an existing list or load protocol/stream configuration."
    ],
    "alternatives": [
      {
        "action": "list.add",
        "when": "Append one signal to an existing list."
      },
      {
        "action": "stream.config.load",
        "when": "Load a valid-ready stream definition."
      }
    ],
    "constraints": [
      "required: name"
    ]
  }
}
