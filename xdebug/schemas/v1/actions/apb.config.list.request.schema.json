{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.apb.config.list.request.v1",
  "title": "apb.config.list request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "apb.config.list"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "List saved APB interface configurations.",
  "x-purpose": "列出 APB 配置。",
  "x-how_it_works": "读取 APB 配置存储；args:{} 列全部，args.name 显示单个配置详情。",
  "x-when_to_use": "查看可用 APB interface 名称。",
  "x-arg_contract_notes": "args:{} list all; optional name shows one config",
  "x-description-zh": "列出 APB 配置。",
  "x-agent": {
    "use_when": [
      "Need to discover saved APB interface names before selecting one, without decoding transfers."
    ],
    "do_not_use_when": [
      "Do not use it to register a configuration or inspect APB transfers."
    ],
    "alternatives": [
      {
        "action": "apb.config.load",
        "when": "Register or replace an APB interface configuration."
      },
      {
        "action": "apb.query",
        "when": "Inspect decoded APB transfers."
      }
    ],
    "constraints": [
      "args:{} list all; optional name shows one config"
    ]
  }
}
