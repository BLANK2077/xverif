{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.session.doctor.request.v1",
  "title": "session.doctor request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "session.doctor"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id"
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Diagnose debug-session resources and accessibility.",
  "x-purpose": "诊断当前 session。",
  "x-how_it_works": "检查 session 资源、路径和可访问状态。",
  "x-when_to_use": "定位 daidir/fsdb/session 绑定问题。",
  "x-arg_contract_notes": "none",
  "x-description-zh": "诊断当前 session。",
  "x-agent": {
    "use_when": [
      "Know a session identifier and need read-only health, resource, process, and accessibility diagnostics."
    ],
    "do_not_use_when": [
      "Do not use it to open, close, or garbage-collect sessions."
    ],
    "alternatives": [
      {
        "action": "session.list",
        "when": "Discover session identifiers."
      },
      {
        "action": "session.close",
        "when": "Gracefully close one session."
      }
    ],
    "constraints": [
      "none"
    ]
  }
}
