{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.signal.canonicalize.request.v1",
  "title": "signal.canonicalize request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "signal.canonicalize"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "daidir": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "daidir"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "daidir"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "signal"
      ],
      "properties": {
        "signal": {
          "type": "string",
          "description": "Final leaf signal path. Aggregate, array, and struct roots are not expanded automatically."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Return the canonical design path for a signal.",
  "x-purpose": "返回信号 canonical 名称。",
  "x-how_it_works": "基于设计解析结果选出规范路径。",
  "x-when_to_use": "让后续 action 使用稳定路径。",
  "x-arg_contract_notes": "required: signal",
  "x-description-zh": "返回信号 canonical 名称。",
  "x-agent": {
    "use_when": [
      "Need one unique exact design match followed through static port connectivity to a canonical path."
    ],
    "do_not_use_when": [
      "Do not use it when multiple candidate discovery is desired or when waveform values are required."
    ],
    "alternatives": [
      {
        "action": "signal.resolve",
        "when": "Return design candidates without selecting a canonical connectivity path."
      },
      {
        "action": "value.at",
        "when": "Read the waveform value of a known leaf path."
      }
    ],
    "constraints": [
      "required: signal"
    ]
  }
}
