{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.signal.changes.request.v1",
  "title": "signal.changes request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "signal.changes"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "signal"
      ],
      "properties": {
        "line_limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
        },
        "mode": {
          "type": "string",
          "description": "Return mode: timeline emits each change evidence, while summary emits aggregate facts only.",
          "enum": [
            "timeline",
            "summary"
          ],
          "default": "timeline"
        },
        "render_time_unit": {
          "type": "string",
          "enum": [
            "auto",
            "ps",
            "ns",
            "us"
          ],
          "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
        },
        "signal": {
          "type": "string",
          "description": "Final leaf signal path. Aggregate, array, and struct roots are not expanded automatically."
        },
        "time_range": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "begin": {
              "type": "string",
              "minLength": 1,
              "description": "闭区间起点；省略时使用可用波形窗口起点。"
            },
            "end": {
              "type": "string",
              "minLength": 1,
              "description": "闭区间终点；省略时使用可用波形窗口终点。"
            }
          },
          "additionalProperties": false,
          "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
        },
        "value_format": {
          "type": "string",
          "enum": [
            "hex",
            "bin",
            "dec"
          ],
          "default": "hex",
          "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "summary"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "line_limit"
              ]
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "List raw waveform value changes for a signal.",
  "x-purpose": "读取信号变化点。",
  "x-how_it_works": "扫描 FSDB value changes；mode:\"timeline\" 可配 line_limit 返回逐项证据，mode:\"summary\" 只返回聚合事实。",
  "x-when_to_use": "看信号何时跳变。",
  "x-arg_contract_notes": "required: signal",
  "x-description-zh": "读取信号变化点。",
  "x-agent": {
    "use_when": [
      "需要一个信号的原始波形变化时间线，或通过 mode=summary 读取不含逐项变化的聚合事实。"
    ],
    "do_not_use_when": [
      "需要按 clock edge 的协议语义采样。"
    ],
    "alternatives": [
      {
        "action": "event.find",
        "when": "需要按 clock 对表达式采样。"
      }
    ],
    "constraints": [
      "required: signal"
    ]
  }
}
