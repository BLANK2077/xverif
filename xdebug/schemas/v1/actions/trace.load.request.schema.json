{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.trace.load.request.v1",
  "title": "trace.load request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "trace.load"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "daidir": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "daidir"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "daidir"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "signal"
      ],
      "properties": {
        "no_statement_only": {
          "type": "boolean",
          "description": "为 true 时排除只代表 statement、没有结构化设计对象语义的 trace 结果。"
        },
        "role": {
          "type": "string",
          "description": "设计 trace 中节点的语义角色过滤。"
        },
        "signal": {
          "type": "string",
          "description": "Final leaf signal path. Aggregate, array, and struct roots are not expanded automatically."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Maximum static load paths returned."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Find static loads of a design signal.",
  "x-purpose": "查找信号 load。",
  "x-how_it_works": "从设计数据库遍历信号使用点。",
  "x-when_to_use": "回答信号影响到哪里。",
  "x-arg_contract_notes": "required: signal",
  "x-description-zh": "查找信号 load。",
  "x-agent": {
    "use_when": [
      "Need all structural consumer pins and fanout endpoints for a design signal without waveform evaluation."
    ],
    "do_not_use_when": [
      "Do not use it to enumerate drivers or decide waveform-time activity."
    ],
    "alternatives": [
      {
        "action": "trace.driver",
        "when": "Enumerate static drivers."
      },
      {
        "action": "trace.active_driver",
        "when": "Find the active driver at one time."
      }
    ],
    "constraints": [
      "required: signal"
    ]
  }
}
