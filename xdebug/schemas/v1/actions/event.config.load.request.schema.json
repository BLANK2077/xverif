{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.event.config.load.request.v1",
  "title": "event.config.load request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "event.config.load"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name",
        "config_path"
      ],
      "properties": {
        "config_path": {
          "type": "string",
          "minLength": 1,
          "description": "输入配置文件路径。"
        },
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Load an event-query configuration.",
  "x-purpose": "加载事件查询配置。",
  "x-how_it_works": "request args 只传 name 和可选 config_path/render_time_unit；clock/edge/sample_point/signals/reset 来自配置文件内容。",
  "x-when_to_use": "复用常见事件查询上下文。",
  "x-arg_contract_notes": "required: name",
  "x-description-zh": "加载事件查询配置。",
  "x-agent": {
    "use_when": [
      "Have a persisted event-query configuration that must be read and registered before event search or export."
    ],
    "do_not_use_when": [
      "Do not use it to enumerate configuration names or execute the configured event search."
    ],
    "alternatives": [
      {
        "action": "event.config.list",
        "when": "Discover saved event configuration names."
      },
      {
        "action": "event.find",
        "when": "Execute an event search."
      }
    ],
    "constraints": [
      "required: name"
    ]
  }
}
