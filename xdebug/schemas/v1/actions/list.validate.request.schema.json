{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.list.validate.request.v1",
  "title": "list.validate request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "list.validate"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Validate signal paths stored in a waveform list.",
  "x-purpose": "验证 list 中信号是否存在。",
  "x-how_it_works": "逐条检查 FSDB signal handle。",
  "x-when_to_use": "发现过期或错误路径。",
  "x-arg_contract_notes": "required: name",
  "x-description-zh": "验证 list 中信号是否存在。",
  "x-agent": {
    "use_when": [
      "Need to prove every stored list entry resolves against the active waveform before sampling or export."
    ],
    "do_not_use_when": [
      "Do not use it merely to display stored names or to evaluate their waveform values."
    ],
    "alternatives": [
      {
        "action": "list.show",
        "when": "Display stored list contents."
      },
      {
        "action": "value.at",
        "when": "Read waveform values after validation."
      }
    ],
    "constraints": [
      "required: name"
    ]
  }
}
