{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.scope.list.request.v1",
  "title": "scope.list request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "scope.list"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "daidir": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "daidir"
                ]
              },
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "anyOf": [
            {
              "required": [
                "daidir"
              ]
            },
            {
              "required": [
                "fsdb"
              ]
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [],
      "properties": {
        "exclude_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，并优先于 include_patterns。"
          },
          "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，并优先于 include_patterns。"
        },
        "include_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，空列表表示全部包含。"
          },
          "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，空列表表示全部包含。"
        },
        "kind": {
          "type": "string",
          "enum": [
            "all",
            "module",
            "interface",
            "interface_array",
            "gen_scope",
            "internal_scope",
            "modport",
            "mpport",
            "port",
            "signal"
          ],
          "default": "all",
          "description": "只返回指定层级对象 kind，或使用 all 返回全部 kind。"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "相对当前 scope 进入真实 module 的层数；0 只列本层对象和直接子 module。"
        },
        "path": {
          "type": "string",
          "description": "Scope path to list. Empty string or '.' returns top-level scopes."
        },
        "source": {
          "type": "string",
          "enum": [
            "wave",
            "design",
            "merged"
          ],
          "default": "wave",
          "description": "Hierarchy evidence source. wave requires FSDB, design requires daidir, and merged requires both resources."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum hierarchy rows returned by the scope traversal."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "List bounded waveform, design, or merged hierarchy objects with source and capability evidence.",
  "x-purpose": "有界列出 waveform/design 层级对象。",
  "x-how_it_works": "source=wave（默认）要求 FSDB，design 要求 daidir，merged 要求两者；保留 level 深度语义。kind 支持 module/interface/interface_array/gen_scope/internal_scope/modport/mpport/port/signal。每项发布 sources/queryable/traceable，summary 发布 visited_count 与 canonical 完整性字段。",
  "x-when_to_use": "发现 elaborated generate、interface array、modport/mpport，或把设计层级证据与波形可查询性合并。",
  "x-arg_contract_notes": "optional: source(default wave), path, level(default 0), kind(default all), include_patterns, exclude_patterns; limits: max_rows",
  "x-description-zh": "有界列出 waveform、design 或 merged 层级对象，并保留来源与可查询/可追踪能力证据。",
  "x-agent": {
    "use_when": [
      "Need bounded hierarchy discovery from waveform, design, or both, including generate scopes, interfaces, interface arrays, modports, and mpports."
    ],
    "do_not_use_when": [
      "Do not use it when only database roots are needed or one known leaf signal must be resolved."
    ],
    "alternatives": [
      {
        "action": "scope.roots",
        "when": "Return only waveform/design roots."
      },
      {
        "action": "signal.resolve",
        "when": "Resolve one design signal query."
      }
    ],
    "constraints": [
      "optional: source(default wave), path, level(default 0), kind(default all), include_patterns, exclude_patterns; limits: max_rows"
    ]
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "args"
              ]
            }
          },
          {
            "properties": {
              "args": {
                "not": {
                  "required": [
                    "source"
                  ]
                }
              }
            },
            "required": [
              "args"
            ]
          },
          {
            "properties": {
              "args": {
                "properties": {
                  "source": {
                    "const": "wave"
                  }
                },
                "required": [
                  "source"
                ]
              }
            },
            "required": [
              "args"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "target": {
            "anyOf": [
              {
                "required": [
                  "session_id"
                ]
              },
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "args": {
            "properties": {
              "source": {
                "const": "design"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        "required": [
          "args"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "anyOf": [
              {
                "required": [
                  "session_id"
                ]
              },
              {
                "required": [
                  "daidir"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "args": {
            "properties": {
              "source": {
                "const": "merged"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        "required": [
          "args"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "anyOf": [
              {
                "required": [
                  "session_id"
                ]
              },
              {
                "required": [
                  "daidir",
                  "fsdb"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
