{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.signal.resolve.request.v1",
  "title": "signal.resolve request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "signal.resolve"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "daidir": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "daidir"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "daidir"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "signal"
      ],
      "properties": {
        "signal": {
          "type": "string",
          "description": "Final leaf signal path. Aggregate, array, and struct roots are not expanded automatically."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Resolve a design signal to canonical candidates.",
  "x-purpose": "解析设计信号。",
  "x-how_it_works": "在设计数据库里查找 signal 并返回候选/规范路径。",
  "x-when_to_use": "消除层次或别名不确定性。",
  "x-arg_contract_notes": "required: signal",
  "x-description-zh": "解析设计信号。",
  "x-agent": {
    "use_when": [
      "Need the complete candidate set for a design signal query and do not want implicit selection."
    ],
    "do_not_use_when": [
      "Do not use it to follow static port connectivity to one canonical path or to sample waveform values."
    ],
    "alternatives": [
      {
        "action": "signal.canonicalize",
        "when": "Require one unambiguous canonical connectivity result."
      },
      {
        "action": "value.at",
        "when": "Read a known waveform path."
      }
    ],
    "constraints": [
      "required: signal"
    ]
  }
}
