{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.signal.anomaly.inspect.request.v1",
  "title": "signal.anomaly.inspect request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "signal.anomaly.inspect"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "signals"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "description": "一项由 type 判别的 abnormal 检查。",
            "oneOf": [
              {
                "type": "object",
                "description": "unknown_xz 检查项。",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "unknown_xz",
                    "description": "报告区间内出现的 X/Z。"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "glitch 检查项。",
                "required": [
                  "type",
                  "min_pulse_width"
                ],
                "properties": {
                  "type": {
                    "const": "glitch",
                    "description": "选择短脉冲检查。"
                  },
                  "min_pulse_width": {
                    "type": "string",
                    "description": "报告严格短于该 canonical duration 的脉冲。"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "stuck 检查项。",
                "required": [
                  "type",
                  "min_duration"
                ],
                "properties": {
                  "type": {
                    "const": "stuck",
                    "description": "选择长时间不变检查。"
                  },
                  "min_duration": {
                    "type": "string",
                    "description": "报告持续至少该 canonical duration 的不变区间。"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "description": "要执行的 raw-waveform 检查。省略时执行运行时默认检查集合；字符串 shorthand 不被接受。"
        },
        "line_limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
        },
        "render_time_unit": {
          "type": "string",
          "enum": [
            "auto",
            "ps",
            "ns",
            "us"
          ],
          "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Signal-path list or alias-to-path/expression map. Expressions must reference aliases rather than nested paths."
          },
          "description": "信号列表，或 alias 到信号路径的映射。"
        },
        "time_range": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "begin": {
              "type": "string",
              "minLength": 1,
              "description": "闭区间起点；省略时使用可用波形窗口起点。"
            },
            "end": {
              "type": "string",
              "minLength": 1,
              "description": "闭区间终点；省略时使用可用波形窗口终点。"
            }
          },
          "additionalProperties": false,
          "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
        },
        "value_format": {
          "type": "string",
          "enum": [
            "hex",
            "bin",
            "dec"
          ],
          "default": "hex",
          "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Detect waveform glitches, unknown values, and stuck signals.",
  "x-purpose": "扫描常见波形异常。",
  "x-how_it_works": "对 signals 执行 glitch/stuck/unknown 等检查并返回 findings；valid/ready 协议里的合法 idle/backpressure 不应只凭 stuck finding 判为 bug。",
  "x-when_to_use": "快速发现值得展开的异常窗口。",
  "x-arg_contract_notes": "required: signals",
  "x-description-zh": "扫描常见波形异常。",
  "x-agent": {
    "use_when": [
      "需要在 raw waveform 中检查 X/Z、短脉冲或长时间不变。"
    ],
    "do_not_use_when": [
      "需要证明 valid-ready 协议违规。"
    ],
    "alternatives": [
      {
        "action": "protocol.handshake.inspect",
        "when": "需要协议层 stall 或稳定性结论。"
      }
    ],
    "constraints": [
      "required: signals"
    ]
  }
}
