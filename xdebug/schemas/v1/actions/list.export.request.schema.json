{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.list.export.request.v1",
  "title": "list.export request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "list.export"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "line_limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
        },
        "name": {
          "type": "string",
          "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
        },
        "output": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Artifact directory; omit it to return an in-response preview."
            },
            "file_format": {
              "type": "string",
              "enum": [
                "u64bin"
              ],
              "default": "u64bin",
              "description": "Waveform-list artifact format; the manifest publishes u64bin.v1."
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "file_format"
                ]
              },
              "then": {
                "required": [
                  "path"
                ]
              },
              "description": "Export destination and rendering controls. path, file_format, and verbose are supported only where this action declares them."
            }
          ],
          "additionalProperties": false,
          "description": "Export destination and rendering controls. path, file_format, and verbose are supported only where this action declares them."
        },
        "render_time_unit": {
          "type": "string",
          "enum": [
            "auto",
            "ps",
            "ns",
            "us"
          ],
          "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
        },
        "time_range": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "begin": {
              "type": "string",
              "minLength": 1,
              "description": "闭区间起点；省略时使用可用波形窗口起点。"
            },
            "end": {
              "type": "string",
              "minLength": 1,
              "description": "闭区间终点；省略时使用可用波形窗口终点。"
            }
          },
          "additionalProperties": false,
          "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "output"
            ],
            "properties": {
              "output": {
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "line_limit"
              ]
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Export waveform-list data.",
  "x-purpose": "导出 list 数据。",
  "x-how_it_works": "读取 list 信号并写出 u64bin 波形表；manifest format 为 u64bin.v1。",
  "x-when_to_use": "把窗口数据交给外部分析。",
  "x-arg_contract_notes": "required: name; format: u64bin only",
  "x-description-zh": "导出 list 数据。",
  "x-agent": {
    "use_when": [
      "Need multi-signal values from a saved list written to a declared artifact or returned as an export preview."
    ],
    "do_not_use_when": [
      "Do not use it when no file or multi-signal preview is needed, or for a single point read."
    ],
    "alternatives": [
      {
        "action": "value.at",
        "when": "Read list values at one or more times."
      },
      {
        "action": "list.load",
        "when": "Load a reusable signal set from JSON configuration before point reads."
      }
    ],
    "constraints": [
      "required: name; format: u64bin only"
    ]
  }
}
