{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.nwave.rc.generate.request.v1",
  "title": "nwave.rc.generate request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "args",
    "target"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "nwave.rc.generate"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fsdb": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fsdb"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "session_id"
            ]
          },
          "required": [
            "fsdb"
          ]
        }
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [
        "config_path",
        "output"
      ],
      "properties": {
        "config_path": {
          "type": "string",
          "minLength": 1,
          "description": "输入配置文件路径。"
        },
        "output": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Required destination path for the generated waveform RC artifact."
            }
          },
          "additionalProperties": false,
          "description": "Export destination and rendering controls. path, file_format, and verbose are supported only where this action declares them."
        },
        "render_time_unit": {
          "type": "string",
          "enum": [
            "auto",
            "ps",
            "ns",
            "us"
          ],
          "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Generate a grouped waveform-view RC file.",
  "x-purpose": "根据分组生成波形 rc。",
  "x-how_it_works": "读取配置并写出 output.path，返回 group/signal 统计。",
  "x-when_to_use": "把调试信号集合导入波形工具。",
  "x-arg_contract_notes": "required: config_path, output",
  "x-description-zh": "根据分组生成波形 rc。",
  "x-agent": {
    "use_when": [
      "需要从分组信号生成可复用 waveform rc 配置。"
    ],
    "do_not_use_when": [
      "需要直接导出当前 waveform evidence 或查询一个信号。"
    ],
    "alternatives": [
      {
        "action": "list.export",
        "when": "需要导出 list 的当前数据。"
      }
    ],
    "constraints": [
      "required: config_path, output"
    ]
  }
}
