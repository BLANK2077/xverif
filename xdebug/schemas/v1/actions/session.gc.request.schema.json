{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.session.gc.request.v1",
  "title": "session.gc request",
  "type": "object",
  "required": [
    "api_version",
    "action"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "xdebug.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "session.gc"
      ]
    },
    "target": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Garbage-collect expired debug sessions.",
  "x-purpose": "清理过期 session。",
  "x-how_it_works": "扫描 session 管理状态并回收可释放项。",
  "x-when_to_use": "避免长期运行时积累无用资源。",
  "x-arg_contract_notes": "none",
  "x-description-zh": "清理过期 session。",
  "x-agent": {
    "use_when": [
      "Need policy-driven cleanup of all expired session records rather than mutation of one named active session."
    ],
    "do_not_use_when": [
      "Do not use it to remove a specific active session or diagnose one session."
    ],
    "alternatives": [
      {
        "action": "session.kill",
        "when": "Force removal of one explicit session."
      },
      {
        "action": "session.doctor",
        "when": "Diagnose one explicit session."
      }
    ],
    "constraints": [
      "none"
    ]
  }
}
