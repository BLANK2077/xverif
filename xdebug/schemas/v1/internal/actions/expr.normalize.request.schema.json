{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.internal.engine.request.v1.action.expr.normalize",
  "title": "xdebug.internal.v1 expr.normalize engine request",
  "description": "Generated strict per-action projection of the private frontend-to-engine request contract.",
  "type": "object",
  "required": [
    "api_version",
    "action"
  ],
  "properties": {
    "api_version": {},
    "action": {},
    "observability": {},
    "routing": {},
    "target": {},
    "args": {},
    "limits": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "type": "object",
      "required": [
        "api_version",
        "action"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "enum": [
            "xdebug.internal.v1"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "expr.normalize"
          ]
        },
        "observability": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_span_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved engine session destination."
            },
            "daidir": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved design database path used to open an engine."
            },
            "fsdb": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved waveform database path used to open an engine."
            },
            "mode": {
              "type": "string",
              "enum": [
                "design",
                "waveform",
                "combined"
              ],
              "description": "Resource mode derived by the frontend from resolved resources."
            },
            "transport_auth_token": {
              "type": "string",
              "minLength": 1,
              "description": "TCP transport credential; never part of xdebug.v1."
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "daidir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "args": {
          "type": "object",
          "required": [],
          "properties": {
            "expr": {
              "type": "string",
              "description": "在指定采样语义下求值或匹配的表达式。"
            },
            "line_limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
            },
            "no_statement_only": {
              "type": "boolean",
              "description": "为 true 时排除只代表 statement、没有结构化设计对象语义的 trace 结果。"
            },
            "role": {
              "type": "string",
              "description": "设计 trace 中节点的语义角色过滤。"
            },
            "signal": {
              "type": "string",
              "description": "Final leaf signal path. Aggregate, array, and struct roots are not expanded automatically."
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "expr"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "signal"
                    ]
                  },
                  {
                    "required": [
                      "line_limit"
                    ]
                  },
                  {
                    "required": [
                      "no_statement_only"
                    ]
                  },
                  {
                    "required": [
                      "role"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "signal"
              ],
              "not": {
                "required": [
                  "expr"
                ]
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "args"
          ],
          "properties": {
            "args": {
              "required": [
                "expr"
              ]
            },
            "target": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "not": {
            "required": [
              "routing"
            ]
          }
        },
        {
          "required": [
            "args",
            "target",
            "routing"
          ],
          "properties": {
            "args": {
              "required": [
                "signal"
              ]
            },
            "target": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string",
                  "minLength": 1
                },
                "daidir": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "oneOf": [
                {
                  "required": [
                    "session_id"
                  ],
                  "not": {
                    "required": [
                      "daidir"
                    ]
                  }
                },
                {
                  "required": [
                    "daidir"
                  ],
                  "not": {
                    "required": [
                      "session_id"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            },
            "routing": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Resolved engine session destination."
                },
                "daidir": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Resolved design database path used to open an engine."
                },
                "fsdb": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Resolved waveform database path used to open an engine."
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "design",
                    "waveform",
                    "combined"
                  ],
                  "description": "Resource mode derived by the frontend from resolved resources."
                },
                "transport_auth_token": {
                  "type": "string",
                  "minLength": 1,
                  "description": "TCP transport credential; never part of xdebug.v1."
                }
              },
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "daidir",
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "design"
                    }
                  },
                  "not": {
                    "required": [
                      "fsdb"
                    ]
                  }
                },
                {
                  "required": [
                    "daidir",
                    "fsdb",
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "combined"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
