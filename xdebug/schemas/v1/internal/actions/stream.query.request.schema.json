{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.internal.engine.request.v1.action.stream.query",
  "title": "xdebug.internal.v1 stream.query engine request",
  "description": "Generated strict per-action projection of the private frontend-to-engine request contract.",
  "type": "object",
  "required": [
    "api_version",
    "action"
  ],
  "properties": {
    "api_version": {},
    "action": {},
    "observability": {},
    "routing": {},
    "target": {},
    "args": {},
    "limits": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "type": "object",
      "required": [
        "api_version",
        "action",
        "args",
        "target",
        "routing"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "enum": [
            "xdebug.internal.v1"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "stream.query"
          ]
        },
        "observability": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_span_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved engine session destination."
            },
            "daidir": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved design database path used to open an engine."
            },
            "fsdb": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved waveform database path used to open an engine."
            },
            "mode": {
              "type": "string",
              "enum": [
                "design",
                "waveform",
                "combined"
              ],
              "description": "Resource mode derived by the frontend from resolved resources."
            },
            "transport_auth_token": {
              "type": "string",
              "minLength": 1,
              "description": "TCP transport credential; never part of xdebug.v1."
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "waveform"
                }
              },
              "not": {
                "required": [
                  "daidir"
                ]
              }
            },
            {
              "required": [
                "daidir",
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "combined"
                }
              }
            }
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "fsdb": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "session_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "fsdb"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "required": [
                  "session_id"
                ]
              },
              "required": [
                "fsdb"
              ]
            }
          ],
          "additionalProperties": false
        },
        "args": {
          "type": "object",
          "required": [
            "stream",
            "query"
          ],
          "properties": {
            "cache_scope": {
              "type": "string",
              "enum": [
                "full",
                "range"
              ],
              "default": "full",
              "description": "Base-analysis cache scope. full (default) caches the complete FSDB while the response still honors time_range; range requires a non-empty time_range and caches only that normalized closed interval."
            },
            "channel": {
              "type": "string",
              "description": "协议或 stream 的逻辑 channel 选择；可用值由本 action 的 enum 决定。"
            },
            "filter": {
              "type": "object",
              "required": [
                "fields"
              ],
              "properties": {
                "position": {
                  "type": "string",
                  "enum": [
                    "sop",
                    "eop"
                  ],
                  "description": "packet filter 的边界位置；sop/eop 决定字段在哪个 packet beat 取值。"
                },
                "fields": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "Exact-match branch: at least one listed value must equal the sampled stream field.",
                        "required": [
                          "mode",
                          "values"
                        ],
                        "properties": {
                          "mode": {
                            "const": "exact",
                            "description": "Action processing or return mode. Its legal values, default, and interactions are action-specific."
                          },
                          "values": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "oneOf": [
                                {
                                  "pattern": "^[0-9]+$",
                                  "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                                },
                                {
                                  "pattern": "^(?:[1-9][0-9]*)?'[bB][01](?:_?[01])*$",
                                  "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                                },
                                {
                                  "pattern": "^(?:[1-9][0-9]*)?'[dD][0-9](?:_?[0-9])*$",
                                  "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                                },
                                {
                                  "pattern": "^(?:[1-9][0-9]*)?'[hH][0-9a-fA-F](?:_?[0-9a-fA-F])*$",
                                  "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                                }
                              ],
                              "description": "Known unsigned decimal or b/d/h SystemVerilog literal; X/Z and C-style 0x are rejected."
                            },
                            "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "Inclusive-range branch: the sampled stream field must lie between begin and end.",
                        "required": [
                          "mode",
                          "begin",
                          "end"
                        ],
                        "properties": {
                          "mode": {
                            "const": "range",
                            "description": "Action processing or return mode. Its legal values, default, and interactions are action-specific."
                          },
                          "begin": {
                            "type": "string",
                            "minLength": 1,
                            "oneOf": [
                              {
                                "pattern": "^[0-9]+$",
                                "description": "闭区间起点；省略时使用可用波形窗口起点。"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[bB][01](?:_?[01])*$",
                                "description": "闭区间起点；省略时使用可用波形窗口起点。"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[dD][0-9](?:_?[0-9])*$",
                                "description": "闭区间起点；省略时使用可用波形窗口起点。"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[hH][0-9a-fA-F](?:_?[0-9a-fA-F])*$",
                                "description": "闭区间起点；省略时使用可用波形窗口起点。"
                              }
                            ],
                            "description": "Known unsigned decimal or b/d/h SystemVerilog literal; X/Z and C-style 0x are rejected."
                          },
                          "end": {
                            "type": "string",
                            "minLength": 1,
                            "oneOf": [
                              {
                                "pattern": "^[0-9]+$",
                                "description": "闭区间终点；省略时使用可用波形窗口终点。"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[bB][01](?:_?[01])*$",
                                "description": "闭区间终点；省略时使用可用波形窗口终点。"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[dD][0-9](?:_?[0-9])*$",
                                "description": "闭区间终点；省略时使用可用波形窗口终点。"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[hH][0-9a-fA-F](?:_?[0-9a-fA-F])*$",
                                "description": "闭区间终点；省略时使用可用波形窗口终点。"
                              }
                            ],
                            "description": "Known unsigned decimal or b/d/h SystemVerilog literal; X/Z and C-style 0x are rejected."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "Masked-match branch: compare only stream-field bits selected by mask against value.",
                        "required": [
                          "mode",
                          "value",
                          "mask"
                        ],
                        "properties": {
                          "mode": {
                            "const": "mask",
                            "description": "Action processing or return mode. Its legal values, default, and interactions are action-specific."
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "oneOf": [
                              {
                                "pattern": "^[0-9]+$"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[bB][01](?:_?[01])*$"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[dD][0-9](?:_?[0-9])*$"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[hH][0-9a-fA-F](?:_?[0-9a-fA-F])*$"
                              }
                            ],
                            "description": "Known unsigned decimal or b/d/h SystemVerilog literal; X/Z and C-style 0x are rejected."
                          },
                          "mask": {
                            "type": "string",
                            "minLength": 1,
                            "oneOf": [
                              {
                                "pattern": "^[0-9]+$"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[bB][01](?:_?[01])*$"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[dD][0-9](?:_?[0-9])*$"
                              },
                              {
                                "pattern": "^(?:[1-9][0-9]*)?'[hH][0-9a-fA-F](?:_?[0-9a-fA-F])*$"
                              }
                            ],
                            "description": "Known unsigned decimal or b/d/h SystemVerilog literal; X/Z and C-style 0x are rejected."
                          }
                        },
                        "additionalProperties": false
                      }
                    ],
                    "description": "Value for a caller-defined fields key."
                  },
                  "description": "按 stream field 名组织的过滤条件；每个 key 必须是配置中声明的 beat 或 packet field。",
                  "x-dynamic-map": true,
                  "x-dynamic-contract": "The property name is caller-defined; the value must follow this declared schema."
                }
              },
              "additionalProperties": false,
              "description": "AND-combined Stream field filters; each field selects exact queue, inclusive range, or value/mask."
            },
            "line_limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
            },
            "packet_index": {
              "type": "integer",
              "minimum": 0,
              "description": "当前请求窗口内从 0 开始的 packet 位置；只在 packet 查询模式中有效。"
            },
            "query": {
              "description": "查询种类。beat stream 支持 summary、first/last_transfer、transfer_window、first/last_stall、stall_window；packet stream 还支持 first/last_packet、packet_at、packet_window。启用 filter 时可用集合进一步受 packet 边界限制。",
              "type": "string",
              "enum": [
                "summary",
                "first_transfer",
                "last_transfer",
                "transfer_window",
                "first_stall",
                "last_stall",
                "stall_window",
                "first_packet",
                "last_packet",
                "packet_at",
                "packet_window"
              ]
            },
            "render_time_unit": {
              "type": "string",
              "enum": [
                "auto",
                "ps",
                "ns",
                "us"
              ],
              "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
            },
            "stream": {
              "type": "string",
              "description": "已加载的 stream 配置名称。"
            },
            "time_range": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "begin": {
                  "type": "string",
                  "minLength": 1,
                  "description": "闭区间起点；省略时使用可用波形窗口起点。"
                },
                "end": {
                  "type": "string",
                  "minLength": 1,
                  "description": "闭区间终点；省略时使用可用波形窗口终点。"
                }
              },
              "additionalProperties": false,
              "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
            },
            "value_format": {
              "type": "string",
              "enum": [
                "hex",
                "bin",
                "dec"
              ],
              "default": "hex",
              "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "cache_scope"
                ],
                "properties": {
                  "cache_scope": {
                    "const": "range"
                  }
                }
              },
              "then": {
                "required": [
                  "time_range"
                ],
                "properties": {
                  "time_range": {
                    "anyOf": [
                      {
                        "required": [
                          "begin"
                        ]
                      },
                      {
                        "required": [
                          "end"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
