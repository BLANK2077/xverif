{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.internal.engine.request.v1.action.counter.statistics",
  "title": "xdebug.internal.v1 counter.statistics engine request",
  "description": "Generated strict per-action projection of the private frontend-to-engine request contract.",
  "type": "object",
  "required": [
    "api_version",
    "action"
  ],
  "properties": {
    "api_version": {},
    "action": {},
    "observability": {},
    "routing": {},
    "target": {},
    "args": {},
    "limits": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "type": "object",
      "required": [
        "api_version",
        "action",
        "args",
        "target",
        "routing"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "enum": [
            "xdebug.internal.v1"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "counter.statistics"
          ]
        },
        "observability": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_span_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved engine session destination."
            },
            "daidir": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved design database path used to open an engine."
            },
            "fsdb": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved waveform database path used to open an engine."
            },
            "mode": {
              "type": "string",
              "enum": [
                "design",
                "waveform",
                "combined"
              ],
              "description": "Resource mode derived by the frontend from resolved resources."
            },
            "transport_auth_token": {
              "type": "string",
              "minLength": 1,
              "description": "TCP transport credential; never part of xdebug.v1."
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "waveform"
                }
              },
              "not": {
                "required": [
                  "daidir"
                ]
              }
            },
            {
              "required": [
                "daidir",
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "combined"
                }
              }
            }
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "fsdb": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "session_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "fsdb"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "required": [
                  "session_id"
                ]
              },
              "required": [
                "fsdb"
              ]
            }
          ],
          "additionalProperties": false
        },
        "args": {
          "type": "object",
          "required": [
            "clock",
            "time_range",
            "vld",
            "cnt"
          ],
          "properties": {
            "clock": {
              "type": "string",
              "description": "采样、统计或协议检查使用的 clock 信号路径。"
            },
            "cnt": {
              "type": "string",
              "description": "要统计的 counter 信号路径；按 clock/vld 采样并计算递增、保持和异常跳变。"
            },
            "edge": {
              "type": "string",
              "description": "Clock sampling edge. The schema default is authoritative; negedge often matches monitor semantics."
            },
            "line_limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
            },
            "max_samples": {
              "type": "integer",
              "minimum": 1,
              "description": "允许扫描的时钟采样预算；耗尽表示分析不完整而非仅 response 截断。"
            },
            "render_time_unit": {
              "type": "string",
              "enum": [
                "auto",
                "ps",
                "ns",
                "us"
              ],
              "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
            },
            "sample_point": {
              "type": "string",
              "enum": [
                "before",
                "after"
              ],
              "description": "Before/after observation point for posedge or dual sampling; it does not change the raw waveform range."
            },
            "time_range": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "begin": {
                  "type": "string",
                  "minLength": 1,
                  "description": "闭区间起点；省略时使用可用波形窗口起点。"
                },
                "end": {
                  "type": "string",
                  "minLength": 1,
                  "description": "闭区间终点；省略时使用可用波形窗口终点。"
                }
              },
              "additionalProperties": false,
              "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
            },
            "value_format": {
              "type": "string",
              "enum": [
                "hex",
                "bin",
                "dec"
              ],
              "default": "hex",
              "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
            },
            "vld": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Signal path used directly as the counter-valid predicate."
                },
                {
                  "type": "object",
                  "required": [
                    "expr",
                    "signals"
                  ],
                  "properties": {
                    "expr": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Boolean expression over aliases declared in signals."
                    },
                    "signals": {
                      "type": "object",
                      "minProperties": 1,
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Value for a caller-defined signal alias key. Supply the real signal path or the action-supported expression for that alias."
                      },
                      "x-dynamic-map": true,
                      "description": "Alias-to-waveform-signal map consumed by expr.",
                      "x-dynamic-contract": "Each property key is an alias referenced by this action; each value resolves that alias to a signal path or supported expression."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Expression predicate with an explicit alias-to-signal map."
                }
              ],
              "description": "Signal path or expression defining the valid sampling condition for counter statistics."
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
