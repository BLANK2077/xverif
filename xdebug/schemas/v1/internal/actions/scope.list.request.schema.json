{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.internal.engine.request.v1.action.scope.list",
  "title": "xdebug.internal.v1 scope.list engine request",
  "description": "Generated strict per-action projection of the private frontend-to-engine request contract.",
  "type": "object",
  "required": [
    "api_version",
    "action"
  ],
  "properties": {
    "api_version": {},
    "action": {},
    "observability": {},
    "routing": {},
    "target": {},
    "args": {},
    "limits": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "type": "object",
      "required": [
        "api_version",
        "action",
        "target",
        "routing"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "enum": [
            "xdebug.internal.v1"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "scope.list"
          ]
        },
        "observability": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_span_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved engine session destination."
            },
            "daidir": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved design database path used to open an engine."
            },
            "fsdb": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved waveform database path used to open an engine."
            },
            "mode": {
              "type": "string",
              "enum": [
                "design",
                "waveform",
                "combined"
              ],
              "description": "Resource mode derived by the frontend from resolved resources."
            },
            "transport_auth_token": {
              "type": "string",
              "minLength": 1,
              "description": "TCP transport credential; never part of xdebug.v1."
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "daidir",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "design"
                }
              },
              "not": {
                "required": [
                  "fsdb"
                ]
              }
            },
            {
              "required": [
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "waveform"
                }
              },
              "not": {
                "required": [
                  "daidir"
                ]
              }
            },
            {
              "required": [
                "daidir",
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "combined"
                }
              }
            }
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "daidir": {
              "type": "string",
              "minLength": 1
            },
            "fsdb": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "session_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "daidir"
                    ]
                  },
                  {
                    "required": [
                      "fsdb"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "required": [
                  "session_id"
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "daidir"
                  ]
                },
                {
                  "required": [
                    "fsdb"
                  ]
                }
              ]
            }
          ],
          "additionalProperties": false
        },
        "args": {
          "type": "object",
          "required": [],
          "properties": {
            "exclude_patterns": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，并优先于 include_patterns。"
              },
              "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，并优先于 include_patterns。"
            },
            "include_patterns": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，空列表表示全部包含。"
              },
              "description": "相对当前 scope 的对象名称 glob 列表；列表内取 OR，空列表表示全部包含。"
            },
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "module",
                "interface",
                "interface_array",
                "gen_scope",
                "internal_scope",
                "modport",
                "mpport",
                "port",
                "signal"
              ],
              "default": "all",
              "description": "只返回指定层级对象 kind，或使用 all 返回全部 kind。"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "相对当前 scope 进入真实 module 的层数；0 只列本层对象和直接子 module。"
            },
            "path": {
              "type": "string",
              "description": "Scope path to list. Empty string or '.' returns top-level scopes."
            },
            "source": {
              "type": "string",
              "enum": [
                "wave",
                "design",
                "merged"
              ],
              "default": "wave",
              "description": "Hierarchy evidence source. wave requires FSDB, design requires daidir, and merged requires both resources."
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_rows": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum hierarchy rows returned by the scope traversal."
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "args"
                  ]
                }
              },
              {
                "properties": {
                  "args": {
                    "not": {
                      "required": [
                        "source"
                      ]
                    }
                  }
                },
                "required": [
                  "args"
                ]
              },
              {
                "properties": {
                  "args": {
                    "properties": {
                      "source": {
                        "const": "wave"
                      }
                    },
                    "required": [
                      "source"
                    ]
                  }
                },
                "required": [
                  "args"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "required": [
                      "session_id"
                    ]
                  },
                  {
                    "required": [
                      "fsdb"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "args": {
                "properties": {
                  "source": {
                    "const": "design"
                  }
                },
                "required": [
                  "source"
                ]
              }
            },
            "required": [
              "args"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "required": [
                      "session_id"
                    ]
                  },
                  {
                    "required": [
                      "daidir"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "args": {
                "properties": {
                  "source": {
                    "const": "merged"
                  }
                },
                "required": [
                  "source"
                ]
              }
            },
            "required": [
              "args"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "required": [
                      "session_id"
                    ]
                  },
                  {
                    "required": [
                      "daidir",
                      "fsdb"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
