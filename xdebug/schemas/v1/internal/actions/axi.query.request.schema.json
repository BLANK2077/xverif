                          },
                          {
                            "pattern": "^(?:[1-9][0-9]*)?'[bB][01](?:_?[01])*$",
                            "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                          },
                          {
                            "pattern": "^(?:[1-9][0-9]*)?'[dD][0-9](?:_?[0-9])*$",
                            "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                          },
                          {
                            "pattern": "^(?:[1-9][0-9]*)?'[hH][0-9a-fA-F](?:_?[0-9a-fA-F])*$",
                            "description": "地址或字段过滤的候选值列表；候选之间按 OR 匹配，空列表不合法。"
                          }
                        ],
                        "description": "Known unsigned decimal or b/d/h SystemVerilog literal up to 64 bits; X/Z and C-style 0x are rejected."
