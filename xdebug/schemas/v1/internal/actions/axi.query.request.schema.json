              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "direction"
                      ]
                    },
                    {
                      "required": [
                        "address"
                      ]
                    },
                    {
                      "required": [
                        "id"
                      ]
                    },
                    {
                      "required": [
                        "time_range"
                      ]
                    },
                    {
                      "required": [
                        "last"
                      ]
                    }
                  ]
                }
              }
            }
          ]
