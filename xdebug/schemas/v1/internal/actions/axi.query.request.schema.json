                      "description": "Known unsigned decimal or b/d/h SystemVerilog literal up to 64 bits; X/Z and C-style 0x are rejected."
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "description": "Exactly one AXI ID filtering mode: exact queue or inclusive range."
            },
            "last": {
              "const": true,
              "description": "Select the final transaction matching the other transaction filters."
            },
            "name": {
              "type": "string",
              "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
            },
            "output": {
              "type": "object",
              "properties": {
                "include_data": {
                  "type": "boolean",
                  "default": false,
                  "description": "Include AXI beat payload data in transaction results."
                }
              },
              "additionalProperties": false,
              "description": "Export destination and rendering controls. path, file_format, and verbose are supported only where this action declares them."
            },
            "query": {
              "oneOf": [
                {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "line_limit": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "One-based query, cursor, or list position; the action schema defines its exact reference set."
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "line_limit"
                      ],
                      "description": "Closed query selector; use only the index, channel, time, or filter branches declared by this action's schema."
                    },
                    {
                      "required": [
                        "index"
                      ],
                      "description": "Closed query selector; use only the index, channel, time, or filter branches declared by this action's schema."
                    }
                  ],
                  "additionalProperties": false,
