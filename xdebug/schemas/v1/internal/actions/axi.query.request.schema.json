                  "description": "闭区间终点；省略时使用可用波形窗口终点。"
                }
              },
              "additionalProperties": false,
              "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
            },
            "value_format": {
              "type": "string",
              "enum": [
                "hex",
                "bin",
                "dec"
              ],
              "default": "hex",
              "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "last",
                  "query"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "output"
                ],
                "properties": {
                  "output": {
                    "required": [
                      "include_data"
                    ]
                  }
                }
              },
              "then": {
                "anyOf": [
                  {
                    "required": [
                      "last"
                    ]
                  },
                  {
                    "required": [
                      "query"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "required": [
                      "channel"
                    ]
                  }
