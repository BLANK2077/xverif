{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xdebug.internal.engine.request.v1.action.event.export",
  "title": "xdebug.internal.v1 event.export engine request",
  "description": "Generated strict per-action projection of the private frontend-to-engine request contract.",
  "type": "object",
  "required": [
    "api_version",
    "action"
  ],
  "properties": {
    "api_version": {},
    "action": {},
    "observability": {},
    "routing": {},
    "target": {},
    "args": {},
    "limits": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "type": "object",
      "required": [
        "api_version",
        "action",
        "args",
        "target",
        "routing"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "enum": [
            "xdebug.internal.v1"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "event.export"
          ]
        },
        "observability": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_span_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved engine session destination."
            },
            "daidir": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved design database path used to open an engine."
            },
            "fsdb": {
              "type": "string",
              "minLength": 1,
              "description": "Resolved waveform database path used to open an engine."
            },
            "mode": {
              "type": "string",
              "enum": [
                "design",
                "waveform",
                "combined"
              ],
              "description": "Resource mode derived by the frontend from resolved resources."
            },
            "transport_auth_token": {
              "type": "string",
              "minLength": 1,
              "description": "TCP transport credential; never part of xdebug.v1."
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "waveform"
                }
              },
              "not": {
                "required": [
                  "daidir"
                ]
              }
            },
            {
              "required": [
                "daidir",
                "fsdb",
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "combined"
                }
              }
            }
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "fsdb": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "session_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "fsdb"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "required": [
                  "session_id"
                ]
              },
              "required": [
                "fsdb"
              ]
            }
          ],
          "additionalProperties": false
        },
        "args": {
          "type": "object",
          "required": [
            "expr"
          ],
          "properties": {
            "aggregate": {
              "type": "object",
              "properties": {
                "events": {
                  "type": "boolean",
                  "default": true,
                  "description": "为 false 时不在 response 中返回逐项 events，只返回 aggregate。"
                },
                "group_by": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "要参与聚合分组的 event field 或 signal alias。"
                  },
                  "uniqueItems": true,
                  "description": "聚合分组 key 列表。"
                }
              },
              "additionalProperties": false,
              "description": "导出聚合控制。events=false 时只返回 aggregate；group_by 按 event fields 或 signal aliases 统计。"
            },
            "clock": {
              "type": "string",
              "description": "采样、统计或协议检查使用的 clock 信号路径。"
            },
            "edge": {
              "type": "string",
              "description": "Clock sampling edge. The schema default is authoritative; negedge often matches monitor semantics."
            },
            "expr": {
              "type": "string",
              "description": "在指定采样语义下求值或匹配的表达式。"
            },
            "line_limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Limits returned evidence rows only, not scanning, aggregation, or the verdict; read completeness fields as well."
            },
            "max_events": {
              "type": "integer",
              "minimum": 1,
              "description": "允许处理或写出的事件预算；耗尽会影响 analysis/file completeness。"
            },
            "max_samples": {
              "type": "integer",
              "minimum": 1,
              "description": "允许扫描的时钟采样预算；耗尽表示分析不完整而非仅 response 截断。"
            },
            "mode": {
              "type": "string",
              "enum": [
                "export"
              ],
              "default": "export",
              "description": "Action processing or return mode. Its legal values, default, and interactions are action-specific."
            },
            "name": {
              "type": "string",
              "description": "Saved-object name in this action namespace; do not assume names are shared by cursors, lists, and protocol configs."
            },
            "output": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Artifact path; omit it to return an in-response preview."
                },
                "file_format": {
                  "type": "string",
                  "enum": [
                    "json"
                  ],
                  "default": "json",
                  "description": "Event artifact file format."
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "file_format"
                    ]
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  },
                  "description": "Export destination and rendering controls. path, file_format, and verbose are supported only where this action declares them."
                }
              ],
              "additionalProperties": false,
              "description": "Export destination and rendering controls. path, file_format, and verbose are supported only where this action declares them."
            },
            "render_time_unit": {
              "type": "string",
              "enum": [
                "auto",
                "ps",
                "ns",
                "us"
              ],
              "description": "Controls only canonical response time rendering: auto, ps, ns, or us. It never changes input parsing, sampling, filtering, or ordering."
            },
            "reset": {
              "type": "object",
              "required": [
                "signal",
                "polarity"
              ],
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One-bit final waveform signal path used as reset."
                },
                "polarity": {
                  "type": "string",
                  "enum": [
                    "active_low",
                    "active_high"
                  ],
                  "description": "Level that asserts reset. X, Z, and unavailable samples are conservatively treated as asserted."
                }
              },
              "additionalProperties": false,
              "description": "Reset definition. Both signal and polarity are required when reset is supplied."
            },
            "sample_point": {
              "type": "string",
              "enum": [
                "before",
                "after"
              ],
              "description": "Before/after observation point for posedge or dual sampling; it does not change the raw waveform range."
            },
            "signals": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "description": "Value for a caller-defined signal alias key. Supply the real signal path or the action-supported expression for that alias."
              },
              "x-dynamic-map": true,
              "x-dynamic-contract": "Each property key is an alias referenced by this action; each value resolves that alias to a signal path or supported expression.",
              "description": "信号列表，或 alias 到信号路径的映射。"
            },
            "time_range": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "begin": {
                  "type": "string",
                  "minLength": 1,
                  "description": "闭区间起点；省略时使用可用波形窗口起点。"
                },
                "end": {
                  "type": "string",
                  "minLength": 1,
                  "description": "闭区间终点；省略时使用可用波形窗口终点。"
                }
              },
              "additionalProperties": false,
              "description": "Closed analysis interval. begin and end may be omitted independently to use the available waveform bounds."
            },
            "value_format": {
              "type": "string",
              "enum": [
                "hex",
                "bin",
                "dec"
              ],
              "default": "hex",
              "description": "返回 LogicValue 的显示格式；不改变比较、采样或底层四态值。"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "clock",
                "signals"
              ]
            }
          ],
          "allOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "name",
                      "clock"
                    ]
                  },
                  {
                    "required": [
                      "name",
                      "signals"
                    ]
                  },
                  {
                    "required": [
                      "name",
                      "edge"
                    ]
                  },
                  {
                    "required": [
                      "name",
                      "sample_point"
                    ]
                  },
                  {
                    "required": [
                      "name",
                      "reset"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "required": [
                  "output"
                ],
                "properties": {
                  "output": {
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "line_limit"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "aggregate"
                ],
                "properties": {
                  "aggregate": {
                    "required": [
                      "events"
                    ],
                    "properties": {
                      "events": {
                        "const": false
                      }
                    }
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "line_limit"
                  ]
                }
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "Positive public frontend-to-engine request timeout in milliseconds. Omit limits.timeout_ms to disable the public watchdog."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
