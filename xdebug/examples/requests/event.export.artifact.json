{
  "api_version": "xdebug.v1",
  "action": "event.export",
  "target": {
    "session_id": "case_a"
  },
  "args": {
    "clock": "top.u.clk",
    "signals": {
      "valid": "top.u.valid"
    },
    "expr": "valid == 1",
    "output": {
      "path": "artifacts/event.json",
      "file_format": "json"
    }
  }
}
