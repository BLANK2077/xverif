{
  "api_version": "xdebug.v1",
  "action": "signal.sampled_pulse.inspect",
  "target": {
    "session_id": "case_a"
  },
  "args": {
    "clock": "ai_complex_top.clk",
    "valid": "ai_complex_top.glitch_sig",
    "payloads": ["ai_complex_top.hs_data"],
    "time_range": {
      "begin": "0ns",
      "end": "20ns"
    },
    "edge": "posedge",
    "rules": {
      "payload_changed_without_sampled_valid": "all"
    },
    "line_limit": 5
  }
}
